# =============================================================
# 預設配置：三個模型全部走 OpenRouter，一支 key 就夠。
# 取得 key：https://openrouter.ai/keys
# 這裡的值同時是程式的內建預設，未設定的變數會落回同樣的設定。
# =============================================================

# -------------------------------------------------------------
# 1. 決策模型（每一步選 operation + target，一次請求回答所有 head）
# -------------------------------------------------------------
TYPESAFE_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
TYPESAFE_ENDPOINT=https://openrouter.ai/api/v1
TYPESAFE_MODEL=zhipu/glm-5.3-flash
# 關閉思考鏈可以再快一點；留空則對 OpenRouter 使用 effort=low。
# TYPESAFE_MODEL_REASONING=omit

# 改用 TypeSafe 原生 Jev（constrained choice API，非 OpenAI 格式）時改成：
# TYPESAFE_API_KEY=your_typesafe_api_key
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# -------------------------------------------------------------
# 2. 文字助手（只有 TYPE_TEXT 時才呼叫，負責生成要打進欄位的字）
# -------------------------------------------------------------
TEXT_MODEL_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=zhipu/glm-5.3-flash
# TEXT_MODEL_REASONING=omit

# -------------------------------------------------------------
# 3. 視覺兜底大腦（System 1 卡死時才截圖診斷）
# -------------------------------------------------------------
VISION_SUPERVISOR_ENABLED=true
VISION_MODEL_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OPENROUTER_KEY
VISION_MODEL_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=zhipu/glm-5.3-flash
# 已登入或含敏感資料的 session 請設 false，截圖就不會離開本機。
