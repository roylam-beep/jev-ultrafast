# -------------------------------------------------------------
# 1. TypeSafe Jev 配置（負責 90% 的毫秒級點擊、選單、滾動動作）
# -------------------------------------------------------------
TYPESAFE_API_KEY=your_typesafe_or_openrouter_api_key
TYPESAFE_MODEL=jev-latest
# 如使用 OpenRouter 或代理轉發，可自定義端點（預設: https://api.typesafe.ai/v1/systemone）
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone

# -------------------------------------------------------------
# 2. GLM-5.3-Flash 文字助手 (TEXT_MODEL)
# -------------------------------------------------------------
# 選項 A: 智譜開放平台官方 API (推薦)
TEXT_MODEL_API_KEY=your_zhipu_bigmodel_api_key
TEXT_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TEXT_MODEL=glm-5.3-flash
TEXT_MODEL_REASONING=omit

# 選項 B: 透過 OpenRouter 統一代理
# TEXT_MODEL_API_KEY=your_openrouter_api_key
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=zhipu/glm-5.3-flash
# TEXT_MODEL_REASONING=omit

# -------------------------------------------------------------
# 3. 視覺兜底大腦 (GLM-5.3-Flash Vision Supervisor)
# -------------------------------------------------------------
VISION_SUPERVISOR_ENABLED=true
VISION_MODEL_API_KEY=your_zhipu_bigmodel_api_key
VISION_MODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-5.3-flash
